APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_CANONICAL_REDIRECT=false

# The shop trades in Dhaka and stores its timestamps in that time.
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=steamwalletstore
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Bulk campaign sending: its own queue, drained only when `default` is empty,
# at whatever rate the sending provider will accept.
MAIL_CAMPAIGN_QUEUE=campaigns
MAIL_CAMPAIGN_RATE_PER_MINUTE=60

# Announce campaign mail as bulk via List-Unsubscribe. Leave this off until
# SPF, DKIM and DMARC all pass for the relay you actually send through:
# declaring a message bulk invites the strict checks, and failing them costs
# you the inbox that order mail still reaches. Verify with "Show original" in
# Gmail, then turn it on — providers do reward it.
MAIL_CAMPAIGN_LIST_UNSUBSCRIBE=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# bKash Tokenized Checkout
BKASH_SANDBOX=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL="${APP_URL}/bkash/callback"

# bKash Send Money (manual transfer number shown to customer at checkout)
BKASH_SEND_MONEY_NUMBER=

# Nagad Send Money (manual transfer number shown to customer at checkout)
NAGAD_SEND_MONEY_NUMBER=

# Rocket Send Money (manual transfer number shown to customer at checkout)
ROCKET_SEND_MONEY_NUMBER=

# Admin email for new send money order notifications (defaults to MAIL_FROM_ADDRESS if blank)
ADMIN_NOTIFICATION_EMAIL=

# Nightly competitor price check. The time is read in the application
# timezone set above, so 22:00 is 10 PM in Dhaka. The taka-per-currency rates
# it compares with are set in the admin, under Settings -> Competitor Pricing,
# because they move faster than a deploy.
COMPETITOR_CHECK_ENABLED=true
COMPETITOR_CHECK_TIME=22:00

# How pages are fetched. G2A fingerprints the TLS handshake and answers 403
# to anything that is not a browser, so "browser" is the default and drives
# Chromium through Playwright. Use "http" for a shop that serves plain
# requests -- it is far faster.
COMPETITOR_FETCHER=browser

# Headless is what the bot protection detects: a headless Chromium has its
# connection reset, a headed one is served. Leave this off unless you have
# tested otherwise. On a headless Linux server, run the scheduled command
# behind a virtual display: xvfb-run php artisan competitor:check-prices
COMPETITOR_BROWSER_HEADLESS=false
# On a headless Linux server, put a virtual display in front of it:
#   COMPETITOR_BROWSER_NODE="xvfb-run -a node"
COMPETITOR_BROWSER_NODE=node
COMPETITOR_BROWSER_TIMEOUT=45

# Where Playwright keeps its browsers. Without this it uses the home of
# whoever is running -- so a browser installed by you is invisible to the web
# user, which is the single most common way this fails on a server. Install
# with the same value:
#   sudo PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/ms-playwright npx playwright install --with-deps chromium
#   sudo chmod -R a+rX /usr/local/share/ms-playwright
PLAYWRIGHT_BROWSERS_PATH=

# A home directory the web user can write to. xvfb-run needs one for its X
# authority file. Set it to /tmp if the web user has no usable home.
COMPETITOR_BROWSER_HOME=

# Pacing for the sweep. The delay is the gap between consecutive requests:
# lower it and the run finishes sooner, at a growing risk of the shop refusing
# the address. Set a proxy only if that has already happened.
COMPETITOR_HTTP_DELAY_MS=1500
COMPETITOR_HTTP_TIMEOUT=10
COMPETITOR_HTTP_CONNECT_TIMEOUT=5
COMPETITOR_HTTP_PROXY=

# How long readings are kept before the command prunes them.
COMPETITOR_RETENTION_DAYS=120
